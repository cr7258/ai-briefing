# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase API Keys
# Publishable key (for frontend, public)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (for backend, private)
SUPABASE_SECRET_KEY=sb_secret_xxx

# LLM API (OpenAI compatible)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MiniMax TTS (https://api.minimax.io/v1/t2a_v2)
MINIMAX_API_KEY=your-api-key
MINIMAX_MODEL=speech-2.6-hd
MINIMAX_VOICE_ID=Chinese (Mandarin)_Warm_Girl

# See official docs for available voices:
# https://platform.minimax.io/docs/faq/system-voice-id#system-voice-id-list

# Logging
RUST_LOG=info,ai_briefing_backend=debug

# Schedule (UTC timezone, default 8:00 AM UTC = 4:00 PM Beijing)
CRON_SCHEDULE=0 0 8 * * *

