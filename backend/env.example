# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# LLM API (OpenAI compatible)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Volcengine TTS (Long text async API)
# Doc: https://www.volcengine.com/docs/6561/1096680
# Auth: https://www.volcengine.com/docs/6561/1105162
# Voice types: https://www.volcengine.com/docs/6561/1108211
TTS_BASE_URL=https://openspeech.bytedance.com
TTS_APPID=your-appid
TTS_ACCESS_TOKEN=your-access-token
TTS_VOICE_TYPE=BV700_V2_streaming

# Volcengine TOS (Object Storage)
# Get keys from: https://console.volcengine.com/iam/keymanage/
TOS_ACCESS_KEY=your-access-key-id
TOS_SECRET_KEY=your-secret-access-key
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_REGION=cn-shanghai
TOS_BUCKET=ai-briefing

# Logging
RUST_LOG=info,ai_briefing_backend=debug

# Schedule (UTC timezone, default 22:00 UTC = 06:00 Beijing)
CRON_SCHEDULE=0 0 22 * * *

# News crawling (how many hours back to fetch articles)
NEWS_HOURS_BACK=24

